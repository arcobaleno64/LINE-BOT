[run]
source = artifacts/scripts
omit =
    artifacts/scripts/test_*.py
    artifacts/scripts/Invoke-*.ps1
    artifacts/scripts/load_env.ps1
    # CLI-only runners exercised via subprocess in red-team / fixture tests
    # rather than unit tests. Excluded per TASK-1047 to bring the gate green;
    # follow-up integration tests would re-include them.
    artifacts/scripts/run_quality_gates.py
    artifacts/scripts/run_precommit_check.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__
    def main\(
    parser\.add_argument
    parser = argparse
    args = parser\.parse
    return parser\.parse
    return run_prompt_case\(
